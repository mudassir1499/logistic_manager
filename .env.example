# =============================================================================
# LogiManager environment configuration
# =============================================================================
# Copy this file to ".env" next to manage.py and fill in the real values:
#
#     cp .env.example .env
#
# .env is git-ignored and must NEVER be committed. Anyone who reads it can
# take over the site and the database.
#
# On cPanel you can either upload the .env file, or paste these same
# key/value pairs into Setup Python App -> Environment variables. Real
# environment variables take priority over the .env file.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------
# Generate a fresh key for production and never reuse the development one:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 0 in production. Leaving this at 1 on a live site exposes source code,
# settings and SQL queries to anyone who triggers an error page.
DJANGO_DEBUG=0

# Comma-separated. Must include every hostname the site answers on.
DJANGO_ALLOWED_HOSTS=mudassirllc.com,www.mudassirllc.com

# Comma-separated, and each entry MUST include the scheme (https://).
DJANGO_CSRF_TRUSTED_ORIGINS=https://mudassirllc.com,https://www.mudassirllc.com


# -----------------------------------------------------------------------------
# DATABASE (MySQL via PyMySQL)
# -----------------------------------------------------------------------------
# Leave DB_NAME empty to use the local SQLite file instead (development).
# On cPanel the database and user are usually prefixed with your account name,
# e.g. "mudassirllc_logimanager".
DB_NAME=
DB_USER=
DB_PASSWORD=
# If 'localhost' fails to connect on cPanel, try 127.0.0.1 — some hosts route
# localhost through a unix socket the Python app cannot reach.
DB_HOST=localhost
DB_PORT=3306

# Seconds to keep a database connection open between requests.
DB_CONN_MAX_AGE=60


# -----------------------------------------------------------------------------
# HTTPS
# -----------------------------------------------------------------------------
# Set to 0 ONLY if the SSL certificate is not installed yet. Turn it back to 1
# as soon as https:// works, otherwise logins travel in plain text.
DJANGO_SECURE_SSL=1

# HSTS max-age in seconds. Start small (3600 = 1 hour) and raise to 31536000
# (1 year) once you are confident HTTPS is stable — browsers cache this value
# and it is hard to reverse.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=0


# -----------------------------------------------------------------------------
# PATHS (cPanel)
# -----------------------------------------------------------------------------
# Where collectstatic writes, and where uploads are stored, so Apache can serve
# both directly. Adjust the account name if your home directory differs.
DJANGO_STATIC_ROOT=/home/mudassirllc/public_html/static
DJANGO_MEDIA_ROOT=/home/mudassirllc/public_html/media


# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
# NOTE: SMTP credentials are NOT configured here. They are stored in the
# database and edited in the admin UI at /settings/ , which supports three
# separate sending profiles (order status, security, news).
# See DEPLOY.md, "Email setup", for what to enter.
#
# This address is only a last-resort fallback used before any profile is set up.
DEFAULT_FROM_EMAIL=orders@mudassirllc.com
